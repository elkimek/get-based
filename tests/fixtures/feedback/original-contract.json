  "html": "\n    <div class=\"gb-modal-head feedback-modal-head\">\n      <div><div class=\"gb-modal-kicker\">GitHub issue</div><div class=\"gb-modal-title\">Send Feedback</div></div>\n      <button type=\"button\" class=\"modal-close\" aria-label=\"Close\" data-feedback-action=\"close\">&times;</button>\n    </div>\n    <div class=\"gb-form-body feedback-form-body\">\n      <form class=\"feedback-form\" data-feedback-action=\"submit\">\n        <div class=\"feedback-field\">\n          <label class=\"feedback-label\" for=\"feedback-type\">Type</label>\n          <select class=\"kb-field-control\" id=\"feedback-type\" data-feedback-action=\"placeholder\">\n            <option value=\"bug\">Bug Report</option>\n            <option value=\"feature\">Feature Request</option>\n            <option value=\"idea\">Idea / Suggestion</option>\n            <option value=\"other\">Other</option>\n          </select>\n        </div>\n        <div class=\"feedback-field\">\n          <label class=\"feedback-label\" for=\"feedback-title\">Title</label>\n          <input class=\"kb-field-control\" id=\"feedback-title\" maxlength=\"160\" required>\n        </div>\n        <div class=\"feedback-field\">\n          <label class=\"feedback-label\" for=\"feedback-desc\">Description</label>\n          <textarea class=\"kb-field-control feedback-textarea\" id=\"feedback-desc\" maxlength=\"10000\" required></textarea>\n        </div>\n        <p class=\"feedback-notice\">Public GitHub issue; account required. Keep health data and secrets out of text and screenshots. Includes app/browser settings, never automatic profile or lab attachments.</p>\n        <div id=\"feedback-result\" class=\"feedback-field\" hidden>\n          <p class=\"feedback-notice\" role=\"status\"><span id=\"feedback-status\"></span> <a target=\"_blank\" rel=\"noopener noreferrer\">Continue on GitHub ↗</a>. Submit there to send it.</p>\n          <details>\n            <summary>View or copy full report</summary>\n            <label class=\"feedback-label\" for=\"feedback-draft\">Report preview</label>\n            <textarea id=\"feedback-draft\" class=\"kb-field-control feedback-textarea\" readonly></textarea>\n            <button type=\"button\" class=\"import-btn import-btn-secondary\" data-feedback-action=\"copy\">Copy report</button>\n          </details>\n        </div>\n        <div class=\"feedback-actions\">\n          <button type=\"button\" class=\"import-btn import-btn-secondary\" data-feedback-action=\"close\">Close</button>\n          <button type=\"submit\" class=\"import-btn import-btn-primary\">Open GitHub draft</button>\n        </div>\n      </form>\n    </div>\n  ",
