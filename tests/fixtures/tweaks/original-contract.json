ia-hidden=\"true\"></span>\n      <span>Synth Sunrise</span>\n    </button>\n  \n    <button type=\"button\" class=\"tweaks-theme-btn\" data-theme-id=\"neuromancer\" data-tweaks-action=\"select-theme\">\n      <span class=\"settings-theme-swatch settings-theme-swatch-neuromancer\" aria-hidden=\"true\"></span>\n      <span>Neuromancer</span>\n    </button>\n  </div>\n          </section>\n          <section class=\"tweaks-section\">\n            <div class=\"tweaks-section-title\">Accent color</div>\n            <div class=\"tweaks-accent-row\">\n    <button type=\"button\" class=\"tweaks-accent-btn active\" data-accent-id=\"\" data-tweaks-action=\"select-accent\" title=\"Theme default\" aria-label=\"Theme default\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#4f8cff;--tweak-gradient:linear-gradient(135deg, #4f8cff 0%, #6366f1 100%)\"></span>\n    </button>\n    <button type=\"button\" class=\"tweaks-accent-btn\" data-accent-id=\"blue\" data-tweaks-action=\"select-accent\" title=\"Blue\" aria-label=\"Blue\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#4f8cff;--tweak-gradient:linear-gradient(135deg, #4f8cff 0%, #6366f1 100%)\"></span>\n    </button>\n    <button type=\"button\" class=\"tweaks-accent-btn\" data-accent-id=\"green\" data-tweaks-action=\"select-accent\" title=\"Green\" aria-label=\"Green\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#34d399;--tweak-gradient:linear-gradient(135deg, #34d399 0%, #14b8a6 100%)\"></span>\n    </button>\n    <button type=\"button\" class=\"tweaks-accent-btn\" data-accent-id=\"amber\" data-tweaks-action=\"select-accent\" title=\"Amber\" aria-label=\"Amber\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#f59e0b;--tweak-gradient:linear-gradient(135deg, #f59e0b 0%, #f97316 100%)\"></span>\n    </button>\n    <button type=\"button\" class=\"tweaks-accent-btn\" data-accent-id=\"rose\" data-tweaks-action=\"select-accent\" title=\"Rose\" aria-label=\"Rose\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#f43f5e;--tweak-gradient:linear-gradient(135deg, #f43f5e 0%, #d946ef 100%)\"></span>\n    </button>\n    <button type=\"button\" class=\"tweaks-accent-btn\" data-accent-id=\"cyan\" data-tweaks-action=\"select-accent\" title=\"Cyan\" aria-label=\"Cyan\">\n      <span class=\"tweaks-accent-swatch\" style=\"--tweak-accent:#06b6d4;--tweak-gradient:linear-gradient(135deg, #06b6d4 0%, #2563eb 100%)\"></span>\n    </button></div>\n          </section>\n          <section class=\"tweaks-section\">\n            <div class=\"tweaks-section-title\">Visual modes</div>\n            <div class=\"tweaks-option-row\">\n              <div class=\"settings-copy\">\n                <div class=\"settings-copy-title\">Sunset mode</div>\n                <div class=\"settings-copy-desc\">Warm high-contrast palette for red blue-blocking glasses.</div>\n              </div>\n              <label class=\"toggle-switch\" title=\"Use warm tokens that remain legible through red lenses\">\n                <input type=\"checkbox\" id=\"tweaks-sunset-mode\" checked=\"\" data-tweaks-action=\"toggle-sunset\">\n                <span class=\"toggle-slider\"></span>\n              </label>\n            </div>\n            <div class=\"tweaks-option-row\" id=\"tweaks-crt-effects-row\" hidden=\"\">\n              <div class=\"settings-copy\">\n                <div class=\"settings-copy-title\">CRT effects</div>\n                <div class=\"settings-copy-desc\">Scanlines and phosphor glow for Terminal, Synth Sunrise, and Neuromancer.</div>\n              </div>\n              <label class=\"toggle-switch\" title=\"Apply CRT scanline effects to terminal-style themes\">\n                <input type=\"checkbox\" id=\"tweaks-crt-effects\" disabled=\"\" data-tweaks-action=\"toggle-crt\">\n                <span class=\"toggle-slider\"></span>\n              </label>\n            </div>\n          </section>\n          <section class=\"tweaks-section\">\n            <div class=\"tweaks-section-title\">Dashboard</div>\n            <div class=\"tweaks-action-grid\">\n              <button type=\"button\" data-tweaks-action=\"reset-dashboard\">Reset layout</button>\n              <button type=\"button\" data-tweaks-action=\"clear-dashboard\">Clear all widgets</button>\n              <button type=\"button\" data-tweaks-action=\"organize-dashboard\">Organize widgets</button>\n              <button type=\"button\" data-tweaks-action=\"send-feedback\">Send feedback</button>\n            </div>\n          </section>\n        </div>\n      </aside>\n    </div>",
