{
  "description": "checkJs coverage for Node and serverless production modules.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true
  },
  "include": [
    "api/**/*.js",
    "api/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.ts",
    "server/**/*.js",
    "server/**/*.ts",
    "dev-server.js"
  ]
}
