{
  "description": "Full-app native TypeScript coverage; checkJs remains enabled for compatibility entry points.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true
  },
  "include": [
    "types/globals.d.ts",
    "js/app-shell-hooks.js",
    "js/**/*.ts"
  ],
  "exclude": [
    "js/lens-local-worker.ts"
  ],
  "files": [
    "js/component-inline-style-map.generated.js",
    "js/emf-inline-style-map.generated.js",
    "js/sync-inline-style-map.generated.js",
    "js/ts-state-ui-inline-style-map.generated.js",
    "js/ts-static-ui-inline-style-map.generated.js"
  ]
}
