# Generate a unique value of at least 32 random characters directly on the VPS.
# It keys rotating abuse-control identifiers and must never reach Git or clients.
PROFILE_SHARE_RATE_LIMIT_KEY=

# Compose supplies the bind address, port, database path, and database ceiling.
# Uncomment only to override a non-Compose launch or tune the request timeout.
# PROFILE_SHARE_BIND=127.0.0.1
# PROFILE_SHARE_PORT=8790
# PROFILE_SHARE_SQLITE_PATH=/absolute/path/profile-shares.sqlite
# PROFILE_SHARE_DATABASE_MAX_BYTES=536870912
# PROFILE_SHARE_REQUEST_TIMEOUT_MS=30000
