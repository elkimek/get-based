# Runtime secrets are set only on the VPS. Never commit the populated .env.
OURA_CLIENT_SECRET=
WITHINGS_CLIENT_SECRET=
POLAR_CLIENT_SECRET=
UVDATA_BEARER=

# Optional listener and request tuning. Compose supplies the bind address, port,
# and limiter defaults shown below; uncomment only to override a non-Compose
# launch. The official relay pins the UV upstream in server policy.
# COMPAT_PROXY_BIND=127.0.0.1
# COMPAT_PROXY_PORT=8787
# COMPAT_PROXY_REQUEST_TIMEOUT_MS=190000
PROXY_RATE_LIMIT_MAX=300
PROXY_RATE_LIMIT_WINDOW_MS=60000
