{
  "name": "getbased",
  "version": "1.3.9",
  "private": true,
  "description": "getbased \u2014 open-source health dashboard (PWA)",
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "agent-host": "node server/agent-host-server.js",
    "architecture:build": "node scripts/architecture-map.mjs --write",
    "architecture:check": "node scripts/architecture-map.mjs --check",
    "companion": "node server/agent-host-server.js",
    "companion:bundle": "node scripts/build-companion-bundle.mjs",
    "companion:install": "npm run companion:bundle && node getbased-companion.mjs install",
    "predev-server": "npm run typescript:build && node scripts/build-companion-bundle.mjs",
    "dev-server": "node dev-server.js",
    "marker-schema:build": "node scripts/build-marker-schema.mjs --write && npm run typescript:build",
    "premarker-schema:check": "npm run typescript:build",
    "marker-schema:check": "node scripts/build-marker-schema.mjs --check",
    "marker-terminology:build": "node scripts/build-marker-terminology.mts --write && npm run typescript:build",
    "premarker-terminology:check": "npm run typescript:build",
    "marker-terminology:check": "node scripts/build-marker-terminology.mjs --check",
    "performance:check": "node scripts/sveltekit-performance-budget.mjs",
    "production:build": "node scripts/build-sveltekit.mjs --output dist",
    "production:check": "node scripts/build-sveltekit.mjs --check",
    "quality": "node scripts/quality-guardrails.mjs",
    "sbom": "node scripts/supply-chain.mjs --sbom artifacts/getbased.cdx.json",
    "supply-chain:check": "node scripts/supply-chain.mjs --check",
    "supply-chain:snapshot": "node scripts/supply-chain.mjs --snapshot",
    "test": "vitest run",
    "test:evolu8-browsers": "playwright test --config=playwright.evolu8.config.js",
    "test:firefox": "playwright test --config=playwright.firefox.config.js",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:playwright": "node scripts/local-full-suite-guard.mjs && playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:checkjs": "tsc -p tsconfig.checkjs.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:service-worker": "tsc -p tsconfig.service-worker.json",
    "typecheck:strict-null": "node scripts/strict-null-ratchet.mjs",
    "vendor:build": "node scripts/build-browser-vendors.mjs",
    "vendor:check": "node scripts/build-browser-vendors.mjs --check",
    "vendor:evolu8:build": "node scripts/build-evolu8-vendor.mjs",
    "vendor:evolu8:check": "node scripts/build-evolu8-vendor.mjs --check",
    "test:watch": "vitest",
    "test:routstr-wallet": "PORT=${PORT:-8180} playwright test tests/playwright/routstr-wallet-dom.spec.ts",
    "canary:routstr-real": "node scripts/routstr-real-funds-canary.mjs",
    "test:critical-coverage": "vitest run --config vitest.critical.config.js",
    "typescript:build": "node scripts/build-typescript.ts && npm run styles:build && npm run svelte:build",
    "typecheck:migration": "tsc -p tsconfig.migration.json --noEmit",
    "typecheck:migration-tests": "tsc -p tsconfig.migration-tests.json",
    "migration:progress": "node scripts/migration-progress.js",
    "migration:check": "node scripts/migration-progress.js --check",
    "pretest": "npm run typescript:build",
    "preproduction:build": "npm run typescript:build",
    "preproduction:check": "npm run typescript:build",
    "prepare": "node scripts/prepare.mts",
    "styles:build": "node scripts/build-styles.mjs",
    "styles:check": "node scripts/build-styles.mjs --check",
    "svelte:build": "npm run check --workspace @getbased/svelte-tooling && node scripts/build-svelte.mjs",
    "svelte:check": "npm run check --workspace @getbased/svelte-tooling && node scripts/build-svelte.mjs --check",
    "test:display-pilot": "playwright test --config=playwright.display-pilot.config.js",
    "presveltekit:build": "npm run typescript:build",
    "sveltekit:build": "node scripts/build-sveltekit.mjs",
    "test:sveltekit": "playwright test --config=playwright.sveltekit.config.js",
    "pretest:sveltekit": "npm run sveltekit:build",
    "native:compatibility:check": "node scripts/build-production.mjs --check",
    "prenative:compatibility:check": "npm run typescript:build",
    "prebenchmark:local": "npm run typescript:build",
    "benchmark:local": "node scripts/benchmark-static.mjs",
    "performance:native:check": "playwright test --config=playwright.native-compat.config.js tests/native-compat/cold-load-budget.spec.ts --workers=1",
    "preperformance:check": "npm run typescript:build",
    "preperformance:native:check": "npm run typescript:build"
  },
  "devDependencies": {
    "@cashu/cashu-ts": "4.11.0",
    "@csstools/css-tokenizer": "4.0.0",
    "@evolu/common": "8.24.1",
    "@evolu/web": "3.6.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@phala/dcap-qvl": "0.6.3",
    "@playwright/test": "^1.64.1",
    "@scure/base": "2.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.1.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "axe-core": "4.13.0",
    "elliptic": "file:scripts/vendor-packages/elliptic-verify-only",
    "fake-indexeddb": "^6.2.5",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "^30.0.1",
    "rolldown": "1.2.12",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "venice-e2ee": "https://github.com/elkimek/venice-e2ee/archive/7da6228c0cef3ad516196129eea2f9d64760e6b3.tar.gz",
    "vitest": "^4.1.11",
    "magic-string": "0.30.21",
    "@tailwindcss/node": "4.3.3",
    "postcss": "8.5.26"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "ehbp": "0.3.2",
    "tinfoil": "^1.2.1",
    "undici": "8.11.2"
  },
  "overrides": {
    "@phala/dcap-qvl": {
      "elliptic": "$elliptic"
    },
    "@vercel/blob": {
      "undici": "6.28.1"
    },
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    },
    "vitest": {
      "vite": "8.2.4"
    }
  },
  "workspaces": [
    "tooling/svelte"
  ]
}
