/** Replace the authored shell only; the early legal gate and boot scripts retain their order. */
export function withAppShellSnapshot(index:string,body:string):string {
 const marker=/<!-- APP_SVELTE_SHELL_START[^>]*-->[\s\S]*?<!-- APP_SVELTE_SHELL_END -->/g;
 if([...index.matchAll(marker)].length!==1)throw new Error('Expected one generated App shell section');
 return index.replace(marker,`<!-- APP_SVELTE_SHELL_START: generated by svelte:build -->\n  <div id="app-shell-host" style="display:contents">${body}</div>\n  <!-- APP_SVELTE_SHELL_END -->`);
}
