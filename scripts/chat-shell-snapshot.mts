/** Replace only the native snapshot of the shared authored Svelte Chat shell. */
export function withChatShellSnapshot(index: string, body: string): string {
  const marker = /<!-- CHAT_SVELTE_SHELL_START[^>]*-->[\s\S]*?<!-- CHAT_SVELTE_SHELL_END -->/g;
  if ([...index.matchAll(marker)].length !== 1) throw new Error('Expected one generated Chat shell section');
  return index.replace(marker, `<!-- CHAT_SVELTE_SHELL_START: generated by svelte:build -->\n  <div id="chat-shell-host" style="display:contents">${body}</div>\n  <!-- CHAT_SVELTE_SHELL_END -->`);
}
