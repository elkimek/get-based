// Preserve the owned notice recipe when Tailwind injects a different fallback/support gate.
// Reject unexpected compiler/source shapes; every other generated byte stays untouched.
const SELECTOR = ':where(.gb\\:feedback-notice\\:feedback-notice-block):where(#feedback-modal, #feedback-modal *):is(.feedback-notice)';
const PROPERTIES = ['margin', 'padding', 'border', 'border-radius', 'background', 'color', 'font-size', 'line-height'];
export function restoreFeedbackNoticeRule(compiled: string, recipeSource: string): string {
    const recipes = Array.from(recipeSource.matchAll(/^@utility feedback-notice-block \{\n([^{}]*)^\}/gm));
    if (recipes.length !== 1)
        throw new Error('Expected one literal Feedback notice recipe');
    const body = recipes[0]![1]!;
    const declarations = body.trimEnd().split('\n');
    if (declarations.length !== PROPERTIES.length || declarations.some((line, index) =>
        !line.startsWith(`  ${PROPERTIES[index]}: `) || !line.endsWith(';')))
        throw new Error('Feedback notice recipe declaration shape changed');
    if (declarations[4] !== '  background: color-mix(in srgb, var(--bg-card) 76%, transparent);')
        throw new Error('Feedback notice compiler lowering needs renewed review');
    const original = `${SELECTOR} {\n${declarations.join('\n')}\n}`;
    const expected = `${SELECTOR} {\n${declarations.slice(0, 4).join('\n')}\n`
        + '  background: var(--bg-card);\n'
        + '  @supports (color: color-mix(in lab, red, red)) {\n'
        + `  ${declarations[4]}\n  }\n`
        + `${declarations.slice(5).join('\n')}\n}`;
    if (compiled.split(SELECTOR).length !== 2 || compiled.split(expected).length !== 2)
        throw new Error('Unexpected Feedback notice compiled selector/declaration/support shape');
    const start = compiled.indexOf(expected);
    return compiled.slice(0, start) + original + compiled.slice(start + expected.length);
}
