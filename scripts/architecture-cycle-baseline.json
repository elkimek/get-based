{
  "schemaVersion": 1,
  "maxCyclicModules": 3,
  "maxLargestCyclicComponent": 3,
  "allowedCyclicModules": [
    "js/cycle-import.js",
    "js/cycle.js",
    "js/wearables-apple-health.js"
  ],
  "allowedComputedDynamicImports": [
    {
      "file": "js/lens-local-worker.js",
      "expression": "import(transformersUrl)"
    },
    {
      "file": "js/pdfjs-loader.js",
      "expression": "import(PDFJS_MODULE_URL)"
    }
  ]
}
