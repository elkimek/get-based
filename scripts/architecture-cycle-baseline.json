{
  "schemaVersion": 1,
  "maxCyclicModules": 15,
  "maxLargestCyclicComponent": 12,
  "allowedCyclicModules": [
    "js/cycle-import.js",
    "js/cycle.js",
    "js/data.js",
    "js/profile.js",
    "js/sync-actions.js",
    "js/sync-cutover.js",
    "js/sync-payload.js",
    "js/sync-save-hooks.js",
    "js/sync-storage-cleanup.js",
    "js/sync-tombstones.js",
    "js/sync.js",
    "js/wearables-apple-health.js",
    "js/wearables-connect.js",
    "js/wearables-manual.js",
    "js/wearables-summary.js"
  ],
  "allowedComputedDynamicImports": [
    {
      "file": "js/lens-local-worker.js",
      "expression": "import(transformersUrl)"
    },
    {
      "file": "js/pdfjs-loader.js",
      "expression": "import(PDFJS_MODULE_URL)"
    }
  ]
}
