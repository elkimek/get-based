#!/usr/bin/env node
// Compile the isolated Tailwind pilot and retain the existing lazy CSS URL.
import { execFileSync } from 'node:child_process';
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const OUTPUT = path.join(ROOT, 'css/settings.css');
interface StyleOptions {
    outputPath?: string;
    check?: boolean;
}
async function compileStyles(baseName: string, utilityName: string, outputPath: string, check: boolean, label: string): Promise<void> {
    const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'getbased-styles-'));
    try {
        const compiled = path.join(directory, 'utilities.css');
        execFileSync(process.execPath, [path.join(ROOT, 'node_modules/@tailwindcss/cli/dist/index.mjs'),
            '--input', path.join(ROOT, 'css', utilityName), '--output', compiled, '--minify'], { cwd: ROOT, stdio: ['ignore', 'ignore', 'pipe'] });
        const [base, utilities] = await Promise.all([fs.readFile(path.join(ROOT, 'css', baseName), 'utf8'), fs.readFile(compiled, 'utf8')]);
        const source = `/* Generated by npm run styles:build; edit ${baseName} or ${utilityName}. */\n`
            + base.trimEnd() + '\n\n' + utilities.trimEnd() + '\n';
        if (check) {
            const existing = await fs.readFile(outputPath, 'utf8');
            if (existing !== source)
                throw new Error(`${label} CSS is stale; run npm run styles:build`);
        }
        else
            await fs.writeFile(outputPath, source);
    }
    finally {
        await fs.rm(directory, { recursive: true, force: true });
    }
}
export async function buildStyles({ outputPath = OUTPUT, check = false }: StyleOptions = {}): Promise<void> {
    await compileStyles('settings.base.css', 'settings-display.tailwind.css', outputPath, check, 'Settings');
}
export async function buildProtectionStyles({ outputPath = path.join(ROOT, 'css/data-protection.css'), check = false }: StyleOptions = {}): Promise<void> {
    await compileStyles('data-protection.base.css', 'data-protection.tailwind.css', outputPath, check, 'Data protection');
}
export async function buildChatStyles({ outputPath = path.join(ROOT, 'css/chat-panel-open.css'), check = false }: StyleOptions = {}): Promise<void> {
    await compileStyles('chat-panel-open.base.css', 'chat-navigation.tailwind.css', outputPath, check, 'Chat');
}
if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
    const check = process.argv.includes('--check');
    await buildStyles({ check });
    await buildProtectionStyles({ check });
    await buildChatStyles({ check });
}
