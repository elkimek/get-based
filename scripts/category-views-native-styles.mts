// Compatibility entry: same metadata edit mode, recipes, paths and output as the accepted category build.
export async function compileCategoryViewsNativeStyles(input: string, inputPath: string, root: string,
    onDependency: (dependency: string) => void = () => {}): Promise<CategoryViewsCompileResult> {
    return compileNativeStyleBodies(input, inputPath, root,
        {receivers: [...receivers,...completeFeatureStyleOwnership['category-views'].receivers], declarationCount: 900 + completeFeatureStyleOwnership['category-views'].declarationCount, isolateRecipes: true}, onDependency);
}
