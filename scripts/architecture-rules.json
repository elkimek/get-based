{
  "schemaVersion": 1,
  "groups": [
    {
      "name": "browser",
      "description": "Native browser modules shipped with the static application.",
      "roots": ["js"],
      "mayImport": ["browser"]
    },
    {
      "name": "serverless",
      "description": "Hosted request handlers shared by Vercel and Node deployment entry points.",
      "roots": ["api"],
      "mayImport": ["serverless", "server-shared"]
    },
    {
      "name": "compat-server",
      "description": "Standalone Node compatibility-relay entry point.",
      "roots": ["server/compat-proxy-server.js"],
      "mayImport": ["serverless"]
    },
    {
      "name": "server-shared",
      "description": "Node-only policy and transport code shared by hosted runtimes.",
      "roots": ["lib"],
      "mayImport": ["server-shared"]
    },
    {
      "name": "local-server",
      "description": "Local development server entry point.",
      "roots": ["dev-server.js"],
      "mayImport": ["server-shared"]
    },
    {
      "name": "standalone-server",
      "description": "Operator-deployed profile-share service entry point.",
      "roots": ["server/profile-share-server.js"],
      "mayImport": ["server-shared"]
    },
    {
      "name": "service-worker",
      "description": "Classic service worker entry point and cache-routing runtime.",
      "roots": ["service-worker.js", "service-worker-runtime.js"],
      "mayImport": ["service-worker"]
    }
  ],
  "restrictedImports": [
    {
      "target": "js/client-list-impl.js",
      "allowedImporters": ["js/client-list.js"]
    },
    {
      "target": "js/settings-sync-panel-impl.js",
      "allowedImporters": ["js/settings-sync-panel.js"]
    },
    {
      "target": "js/marker-detail-modal-impl.js",
      "allowedImporters": ["js/marker-detail-modal.js"]
    },
    {
      "target": "js/context-card-dashboard-ai-impl.js",
      "allowedImporters": ["js/context-card-dashboard-ai.js"]
    },
    {
      "target": "js/context-card-medical-history-editor-impl.js",
      "allowedImporters": ["js/context-card-medical-history-editor.js"]
    },
    {
      "target": "js/context-card-lifestyle-editors-impl.js",
      "allowedImporters": ["js/context-card-lifestyle-editors.js"]
    }
  ],
  "entryPoints": [
    "js/main.js",
    "api/commit.js",
    "api/proxy.js",
    "api/share.js",
    "server/compat-proxy-server.js",
    "server/profile-share-server.js",
    "dev-server.js",
    "service-worker.js"
  ],
  "forbiddenRepositoryImportRoots": ["tests", "scripts"]
}
